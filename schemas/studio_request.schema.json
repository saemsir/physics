{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saemphysics.example/schemas/studio_request.schema.json",
  "title": "SaemPhysics Studio Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Repository-relative output root; absolute paths and '..' are rejected."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "action": {
            "enum": [
              "content.initialize",
              "content.summary",
              "content.solve",
              "content.compile_lesson",
              "math.solve_linear",
              "physics.constant_acceleration",
              "exam.recommend",
              "exam.backtest",
              "exam.forecast",
              "exam.import_candidates",
              "exam.render_practice_paper",
              "matrix.build",
              "audio.analyze_reference",
              "production.index_references",
              "production.record_review",
              "video.request",
              "video.lesson_plan",
              "video.batch_plan",
              "video.render_batch"
            ]
          },
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "params": {
            "type": "object",
            "description": "Action-specific arguments. See docs/studio_engine.md."
          }
        }
      }
    }
  }
}
