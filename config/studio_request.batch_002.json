      "action": "exam.forecast",
      "params": {
        "exam": "jee-advanced",
        "target_year": 2027,
        "question_count": 10,
        "simulations": 10000,
        "seed": 2027
      }
    },
    {
      "id": "paper_pdfs",
      "action": "exam.render_practice_paper",
      "params": {
        "paper": "data/practice_papers/jee_advanced_2027_physics_set_01.json"
      }
    }
  ]
}
